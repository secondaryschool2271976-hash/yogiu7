# Optional: PostgreSQL connection string (Render Postgres / Neon / Supabase) for permanent persistence across deploys.
# If omitted, the server falls back to local JSON storage in relay-server/data/store.json.
DATABASE_URL=

# Optional: Public URL of your deployed Render service (used for Google OAuth callback).
PUBLIC_BASE_URL=https://poc-online-relay.onrender.com

# Optional: Google OAuth Web Client credentials to enable "Sign in with Google".
# Authorized redirect URI in Google Cloud Console: https://poc-online-relay.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Admin passcode for the /admin Gift Code Management Panel.
# If omitted, the first visitor to /admin can set the admin passcode once (stored hashed in the database).
ADMIN_PASSCODE=
